# 复制本文件为 .env 并按需修改。所有项都有默认值，缺省也能启动（只是模型调用会失败）。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-v4-pro
# 快模型负责审题/提纲，留空则复用 OPENAI_MODEL
OPENAI_MODEL_FAST=deepseek-flash
# 哪些阶段开启“先思考再输出”（逗号分隔；留空用默认 angle,critique）
THINKING_STAGES=

# 首页展示的班级/姓名/学号
APP_TITLE=高考满分作文智能应用
STUDENT_CLASS=网安243
STUDENT_NAME=刘经治
STUDENT_ID=202401050896

# 存储与签名
DB_PATH=data/app.db
SECRET_KEY=dev-only-change-me-in-env
